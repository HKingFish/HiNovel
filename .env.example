# ========================================================
# HiNovel AI 小说创作平台 - 环境变量配置
# 复制此文件为 .env，填写真实配置后启动服务
# 注意：.env 文件已加入 .gitignore，请勿提交到版本库
# ========================================================

# ============================================================
# 数据库配置（MySQL 8.x）
# ============================================================
# 本地开发连接宿主机映射端口，Docker 容器间使用内网服务名与固定端口
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=hinovel_platform
MYSQL_USER=root
# 全新 Compose 部署默认使用 root，两项设置为同一个强密码。
# 若 MYSQL_USER 指定了已由数据库管理员创建的账号，两项可不同。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ============================================================
# Redis 配置
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis 密码（留空则无密码）
REDIS_PASSWORD=

# ============================================================
# Qdrant 向量数据库配置
# ============================================================
# 本地开发时填写远程地址，Docker 部署时由 docker-compose 覆盖
QDRANT_HOST=localhost
# 本地 Java 客户端默认使用 QDRANT_GRPC_PORT。连接外部 Qdrant 时可单独覆盖。
# QDRANT_PORT=6334
# 宿主机端口映射（仅 docker-compose 使用）
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ============================================================
# 服务端口配置
# ============================================================
SERVER_PORT=8080
# 前端默认 3000 避免与服务器已有 nginx/apache 80 端口冲突；如需 80 在 .env 设置 WEB_PORT=80
WEB_PORT=3000
# Compose 默认仅发布到本机。需要远程访问时配置公网可达的反代或明确调整监听地址。
# WEB_BIND_IP=127.0.0.1
# SERVER_BIND_IP=127.0.0.1
# INFRA_BIND_IP=127.0.0.1

# ============================================================
# OSS 文件存储配置
# ============================================================
# 存储类型：LOCAL（本地存储）或 ALIYUN（阿里云 OSS）
OSS_TYPE=LOCAL

# 本地存储配置（OSS_TYPE=LOCAL 时生效）
OSS_LOCAL_URL_PREFIX=/files
# 本地 Java 的上传目录与应用日志。Docker 使用固定容器路径并挂载到 ../data。
# OSS_LOCAL_PATH=./data/hinovel/uploads
# HINOVEL_LOG_FILE=./logs/hinovel.log

# 阿里云 OSS 配置（OSS_TYPE=ALIYUN 时必填）
OSS_ALIYUN_ENDPOINT=
OSS_ALIYUN_ACCESS_KEY_ID=
OSS_ALIYUN_ACCESS_KEY_SECRET=
OSS_ALIYUN_BUCKET_NAME=

# ============================================================
# Docker 镜像加速（国内无法直连 Docker Hub 时取消注释）
# ============================================================
# 官方镜像使用 library/ 前缀，第三方镜像如 qdrant 不含 library
# DOCKER_IMAGE_MYSQL=docker.m.daocloud.io/library/mysql:8.0
# DOCKER_IMAGE_REDIS=docker.m.daocloud.io/library/redis:7.2-alpine
# DOCKER_IMAGE_QDRANT=docker.m.daocloud.io/qdrant/qdrant:v1.12.5
# DOCKER_IMAGE_MAVEN=docker.m.daocloud.io/library/maven:3.9.6-eclipse-temurin-21
# DOCKER_IMAGE_JRE=docker.m.daocloud.io/library/eclipse-temurin:21-jre-alpine
# DOCKER_IMAGE_NGINX=docker.m.daocloud.io/library/nginx:1.25-alpine

# ============================================================
# 安全配置
# ============================================================
# API 密钥加密密钥（AES-128，至少 16 个字符，必填项，无默认值）
API_KEY_SECRET=
# 多实例分别使用不同机器号（0 到 9），单实例默认 1。
# HINOVEL_MACHINE_ID=1
